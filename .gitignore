# ==========================================
# LLM PDF Ingest & Reader App - .gitignore
# ==========================================

# ------------------------------------------
# OS / System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# Node / Javascript (React Native / Expo)
# ------------------------------------------
node_modules/
/mobile/node_modules/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.eslintcache
.eslintcache*

# Expo / EAS / Metro build files
.expo/
dist/
web-build/
mobile-build/
ios/build/
android/build/
/mobile/ios/
/mobile/android/
*.apk
*.aab
*.ipa

# ------------------------------------------
# Rust Core
# ------------------------------------------
# Top-level workspace target
/rust_core/target/
# Per-crate target directories (generated by cargo)
/rust_core/parser/target/
/rust_core/inference/target/
/rust_core/delineator/target/
/rust_core/desktop_server/target/
/rust_core/dev_server/target/
/rust_core/contracts/target/
# Cargo.lock is committed for the workspace (it is an application, not a library)

# ------------------------------------------
# PDFium Native Binaries
# ------------------------------------------
# Large pre-built native DLLs — should not be committed, fetch at build time
pdfium.dll
*.dll
PDFiumConfig.cmake
args.gn

# ------------------------------------------
# CMake Build Output
# ------------------------------------------
# Generated by cmake --build or cmake -B build
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.vcxproj
*.vcxproj.filters
*.slnx
*.dir/

# ------------------------------------------
# AI / Agent Working Directories
# ------------------------------------------
# Runtime scratch space created by AI coding assistants
.agent/
.agents/

# ------------------------------------------
# IDEs / Editors / Development Tools
# ------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.classpath
.settings/
.clinerules
.cursorrules
.gemini/

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ------------------------------------------
# Local Databases & SQLite Sandbox
# ------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ------------------------------------------
# LLM Models / Local Inference
# ------------------------------------------
# Ignore large binary weights / local model files
*.bin
*.gguf
/models/
/rust_core/models/

# ------------------------------------------
# Downloaded / Ingested Documents & Sandboxes
# ------------------------------------------
# Keep standard repository assets under /assets,
# but ignore ingested sandbox documents, extracts, and temporary storage
/mobile/assets/sandbox/
/mobile/assets/extracted/
output/
downloads/
tmp/
temp/
/scratch/
*.png
*.pdf
*.7z

# ------------------------------------------
# Test Artifacts & Inputs
# ------------------------------------------
/test_artifacts/*
!/test_artifacts/test_inputs/
*.part
*.lock

# ------------------------------------------
# Python Virtual Environments
# ------------------------------------------
venv/
.venv/

# ------------------------------------------
# Third Party / gclient Downloads
# ------------------------------------------
/third_party/.gclient
/third_party/.gclient_entries
/third_party/build/
/third_party/testing/
/third_party/buildtools/
/third_party/.cipd/
/third_party/.gclient_previous_sync_commits
/third_party/.gcs_entries
